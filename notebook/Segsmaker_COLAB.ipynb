# @title 💨 **Temporary Model Downloader** {"display-mode":"form"}
# @markdown ### Temporary Checkpoints
# @markdown > Format: `URL optional_filename`
# @markdown > Example: `https://civitai.com/api/download/models/357609 Juggernaut-XL.safetensors`
TMP_Checkpoint_1 = '' # @param {type:"string", placeholder:"URL [filename] or leave empty"}
TMP_Checkpoint_2 = '' # @param {type:"string", placeholder:"URL [filename] or leave empty"}
# @markdown ---
# @markdown ### Temporary LoRA
TMP_Lora_1 = '' # @param {type:"string", placeholder:"URL or leave empty"}
TMP_Lora_2 = '' # @param {type:"string", placeholder:"URL or leave empty"}

from nenen88 import parallel_batch_download

_tmp_queue = []
for _raw, _dest in [(TMP_Checkpoint_1, TMP_CKPT), (TMP_Checkpoint_2, TMP_CKPT),
                    (TMP_Lora_1, TMP_LORA), (TMP_Lora_2, TMP_LORA)]:
    if not _raw.strip(): continue
    _p = _raw.strip().split(None, 1)
    _tmp_queue.append((_p[0], str(_dest), _p[1] if len(_p) > 1 else None))

if not _tmp_queue: print('  No temporary URLs — skipping.')
else: parallel_batch_download(_tmp_queue, max_workers=3)
